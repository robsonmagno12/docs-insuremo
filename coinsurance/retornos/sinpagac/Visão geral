        <h2>🔄 Lógica de Negócio - Single Module</h2>

        <div class="alert alert-success">
            <strong>✅ Simplicidade:</strong> SINPAGAC usa <strong>apenas ClaimCase</strong>, sem necessidade de buscar ARAP. Todos os dados vêm de um único módulo.
        </div>

        <h3>Implementação Simplificada</h3>
        <pre><code class="language-groovy">// Busca diretamente do ClaimCase (sem buscar ARAP)
List&lt;Map&gt; claimDocs = fetchClaimsBatch(baseDate, cursorId)

claimDocs.each { claimDoc ->
    // Usa ExtMovementType e ExtCededCoinsuranceAmount do ClaimCase
    generateLine(
        tipoMov: resolveSusepMovType(claimDoc.ExtMovementType),
        vrMov: claimDoc.ExtCededCoinsuranceAmount,
        numSin: claimDoc.ExtClaimNo,
        numApol: claimDoc.ExtPolicyNo,
        // ... outros campos do ClaimCase
    )
}</code></pre>

